  "description": "MCP server for the NOVA WORKS event-production app (Crewplanung, Hotel, Schichtplan, Bauzeitenplan) backed by Supabase",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "nova-works-mcp-server": "dist/index.js" },
