# =========================================================================
#  NOVA WORKS - Apache-Konfiguration (Strato, IONOS, All-Inkl, Netcup ...)
#  Weiterleitungen der alten WordPress-Adressen, Caching, Sicherheits-Header.
# =========================================================================

Options -Indexes
DirectoryIndex index.php

# Die Startseite ist seit dem Umbau auf das Backend index.php. Wer noch
# einen Verweis auf index.html hat - aus einer Mail, einem Lesezeichen
# oder einem Suchergebnis -, landet auf der Wurzel statt auf 404.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/index\.html$  /
</IfModule>

# Das Backend, die Inhaltsdatei und die Vorlagen gehen niemanden etwas an,
# der sie nicht bearbeitet. Die Ordner selbst schuetzt jeweils eine eigene
# .htaccess; hier steht der Riegel fuer den Fall, dass eine davon beim
# Hochladen vergessen wurde - Punkt-Dateien blenden viele FTP-Programme aus.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(inhalt|vorlage)/ - [F,L]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS erzwingen -------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Ohne www ---------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_alias.c>
  # --- Alte WordPress-Adressen auf die neuen Seiten --------------------
  RedirectMatch 301 ^/impressum/?$              /impressum.php
  RedirectMatch 301 ^/datenschutzerklaerung/?$  /datenschutz.php
  RedirectMatch 301 ^/datenschutz/?$            /datenschutz.php

  # Die Rechtsseiten waren bis zum Umbau .html-Dateien. Wer noch einen
  # solchen Verweis hat - aus einer Mail, einem Lesezeichen oder einem
  # Suchergebnis -, landet auf der neuen Adresse statt auf 404.
  RedirectMatch 301 ^/impressum\.html$    /impressum.php
  RedirectMatch 301 ^/datenschutz\.html$  /datenschutz.php
  RedirectMatch 301 ^/agb\.html$          /agb.php

  # Der WordPress-Standardbeitrag entfaellt ersatzlos
  RedirectMatch 301 ^/2026/02/06/hallo-welt/?$  /

  # --- Reste der alten Installation ------------------------------------
  # 410 statt 404: sagt Suchmaschinen, dass die Adressen endgueltig weg sind.
  RedirectMatch 410 ^/(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$
  RedirectMatch 410 ^/wp-[a-z0-9-]+\.php$
  RedirectMatch 410 ^/xmlrpc\.php$
  RedirectMatch 410 ^/feed/?$
</IfModule>

ErrorDocument 404 /404.php

# =========================================================================
#  Sicherheits-Header
# =========================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Die Seite laedt nichts von fremden Servern - Schriften liegen lokal.
  # Deshalb kann die Richtlinie so eng sein. Wird spaeter etwas eingebunden
  # (Karte, Video, Analytics), muss die Quelle hier ergaenzt werden.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # HSTS erst einschalten, wenn HTTPS sicher laeuft - sonst sperrt man sich aus.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  Header unset X-Powered-By
</IfModule>

# =========================================================================
#  Caching
#  CSS/JS/Bilder/Schriften ein Jahr, HTML nie.
#
#  Die Versionsnummer hinter style.css und main.js setzt index.php selbst
#  aus dem Aenderungsdatum der Dateien (siehe fassung() in
#  vorlage/helfer.php). Sie muss also nicht mehr von Hand hochgezaehlt
#  werden - genau das wurde frueher regelmaessig vergessen.
#
#  Bilder tragen ihre Breite im Namen (header-1280.webp). Eine neue
#  Fassung bekommt einen neuen Namen, sobald sich die Breite aendert;
#  wird ein Foto unter gleichem Namen ersetzt, leert die Mediathek den
#  Zwischenspeicher ueber einen angehaengten Zeitstempel.
# =========================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"

  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# =========================================================================
#  Komprimierung
# =========================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddCharset UTF-8 .html .css .js .xml .txt
</IfModule>

# =========================================================================
#  Zugriffsschutz
# =========================================================================
<FilesMatch "^\.(htaccess|htpasswd|env|git)">
  Require all denied
</FilesMatch>
